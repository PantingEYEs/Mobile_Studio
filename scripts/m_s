#!/data/data/com.termux/files/usr/bin/bash

PROJECT_DIR="$HOME/Mobile_Studio"
FRONTEND_DIR="$PROJECT_DIR/frontend"
BIN_PATH="$PROJECT_DIR/bin/server"
PORT=8080
TARGET_URL="http://127.0.0.1:$PORT"

is_running() {
    (echo > /dev/tcp/127.0.0.1/$PORT) >/dev/null 2>&1
}

case "$1" in
    :q|:q!|:wq|quit)
        echo "[m_s] 正在停止后台服务..."
        kill -9 $(lsof -t -i :$PORT 2>/dev/null) 2>/dev/null
        pkill -f "$BIN_PATH" 2>/dev/null
        pkill -f "server" 2>/dev/null
        echo "[m_s] 服务已彻底退出，端口已释放。"
        exit 0
        ;;
esac

echo "=== Mobile Studio 启动器 ==="

# 1. 依赖自检
for cmd in go git node npm; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "[m_s] 未检测到 $cmd，正在自动补全..."
        pkg install -y "$cmd"
    fi
done

# 2. 检查前端产物
if [ ! -d "$FRONTEND_DIR/dist" ]; then
    echo "[m_s] 未发现前端产物，正在构建 Svelte..."
    (cd "$FRONTEND_DIR" && npm run build)
fi

# 3. 智能增量编译：main.go 变动 或 前端 dist 变动，都会触发重新打包！
mkdir -p "$PROJECT_DIR/bin"
if [ ! -f "$BIN_PATH" ] || [ "$PROJECT_DIR/main.go" -nt "$BIN_PATH" ] || [ "$FRONTEND_DIR/dist/index.html" -nt "$BIN_PATH" ]; then
    echo "[m_s] 检测到源码或前端静态产物变动，正在重新内嵌编译..."
    (cd "$PROJECT_DIR" && go build -o "$BIN_PATH" main.go)
    if [ $? -ne 0 ]; then
        echo "[m_s] 编译失败，请检查代码！"
        exit 1
    fi
fi

# 4. 后台启动服务
if is_running; then
    echo "[m_s] 本地服务已处于运行状态 (端口 $PORT)。"
else
    echo "[m_s] 启动本地后台服务..."
    nohup "$BIN_PATH" > "$PROJECT_DIR/server.log" 2>&1 &
    
    for i in {1..6}; do
        if is_running; then
            break
        fi
        sleep 0.5
    done
fi

# 5. 调起系统预设浏览器
echo "[m_s] 正在调起系统预设浏览器..."
if command -v termux-open-url >/dev/null 2>&1; then
    termux-open-url "$TARGET_URL"
else
    am start -a android.intent.action.VIEW \
             -c android.intent.category.BROWSABLE \
             -c android.intent.category.DEFAULT \
             -d "$TARGET_URL" \
             --activity-clear-top >/dev/null 2>&1
fi

echo "[m_s] 启动完成！提示：可输入 m_s :q 退出/停止服务。"
