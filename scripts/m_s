#!/data/data/com.termux/files/usr/bin/bash
# Mobile Studio 启动器与命令行入口。
#   服务生命周期（start / stop / restart / open / logs / rebuild）由本脚本处理；
#   其余命令交给 Go 二进制（bin/server）执行，完整列表见 m_s help。
# 脚本自身的提示信息一律输出到 stderr，保证 --json 等命令的 stdout 可被程序直接解析。

PROJECT_DIR="${MS_ROOT:-$HOME/Mobile_Studio}"
FRONTEND_DIR="$PROJECT_DIR/frontend"
BIN_PATH="$PROJECT_DIR/bin/server"
CONFIG_DIR="${MS_CONFIG_DIR:-$HOME/.mobile_studio}"
PID_FILE="$CONFIG_DIR/server.pid"
LOG_FILE="$PROJECT_DIR/server.log"

log() { echo "[m_s] $*" >&2; }

# ---------- 构建 ----------

ensure_deps() {
    for cmd in go git node npm; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            log "未检测到 $cmd，正在自动补全..."
            pkg install -y "$cmd" >&2
        fi
    done
}

# 按需安装前端依赖、构建前端、编译 Go 二进制（均为增量判断）
ensure_built() {
    ensure_deps
    # node_modules 缺失，或 package-lock.json 比上次安装记录（npm 写入的 node_modules/.package-lock.json）更新时安装依赖
    if [ ! -f "$FRONTEND_DIR/node_modules/.package-lock.json" ] || \
       [ "$FRONTEND_DIR/package-lock.json" -nt "$FRONTEND_DIR/node_modules/.package-lock.json" ]; then
        log "检测到前端依赖变动，正在安装..."
        (cd "$FRONTEND_DIR" && npm install >&2) || { log "前端依赖安装失败！"; return 1; }
    fi
    # dist 缺失，或 src / index.html 有比产物更新的文件时重新构建
    if [ ! -f "$FRONTEND_DIR/dist/index.html" ] || \
       [ -n "$(find "$FRONTEND_DIR/src" "$FRONTEND_DIR/index.html" -newer "$FRONTEND_DIR/dist/index.html" -print -quit 2>/dev/null)" ]; then
        log "检测到前端源码变动，正在构建 Svelte..."
        (cd "$FRONTEND_DIR" && npm run build >&2) || { log "前端构建失败！"; return 1; }
    fi
    # 任一 *.go / go.mod 或前端产物变动时重新编译
    mkdir -p "$PROJECT_DIR/bin"
    if [ ! -f "$BIN_PATH" ] || \
       [ -n "$(find "$PROJECT_DIR/" -maxdepth 1 -name '*.go' -newer "$BIN_PATH" -print -quit)" ] || \
       [ "$PROJECT_DIR/go.mod" -nt "$BIN_PATH" ] || [ "$FRONTEND_DIR/dist/index.html" -nt "$BIN_PATH" ]; then
        log "检测到源码或前端静态产物变动，正在重新内嵌编译..."
        (cd "$PROJECT_DIR" && go build -o "$BIN_PATH" .) || { log "编译失败，请检查代码！"; return 1; }
        if is_running; then
            log "提示：后台服务仍在运行旧版本，执行 m_s restart 使新版本生效"
        fi
    fi
}

# ---------- 服务 ----------

port() {
    local p=""
    [ -x "$BIN_PATH" ] && p=$("$BIN_PATH" config get server.port 2>/dev/null)
    [[ "$p" =~ ^[0-9]+$ ]] && echo "$p" || echo 8080
}

is_running() {
    (echo > "/dev/tcp/127.0.0.1/$(port)") >/dev/null 2>&1
}

start_server() {
    local p
    p=$(port)
    if is_running; then
        log "服务已在运行（端口 $p）。"
        return 0
    fi
    mkdir -p "$CONFIG_DIR"
    log "启动本地后台服务（端口 $p）..."
    nohup "$BIN_PATH" serve > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    for _ in $(seq 1 24); do
        is_running && return 0
        sleep 0.25
    done
    log "服务启动失败，最近日志："
    tail -n 20 "$LOG_FILE" >&2
    return 1
}

stop_server() {
    local p pids
    p=$(port)
    log "正在停止后台服务..."
    if [ -f "$PID_FILE" ]; then
        kill "$(cat "$PID_FILE")" 2>/dev/null
        rm -f "$PID_FILE"
    fi
    # 兜底：结束本项目二进制的其它实例，以及仍占用端口的进程（只匹配完整路径，不误杀其它程序）
    pkill -f "$BIN_PATH" 2>/dev/null
    pids=$(lsof -t -i :"$p" 2>/dev/null)
    [ -n "$pids" ] && kill $pids 2>/dev/null
    for _ in $(seq 1 12); do
        is_running || break
        sleep 0.25
    done
    if is_running; then
        pids=$(lsof -t -i :"$p" 2>/dev/null)
        [ -n "$pids" ] && kill -9 $pids 2>/dev/null
        pkill -9 -f "$BIN_PATH" 2>/dev/null
    fi
    log "服务已停止，端口 $p 已释放。"
}

open_browser() {
    local url="http://127.0.0.1:$(port)"
    log "正在打开 $url ..."
    if command -v termux-open-url >/dev/null 2>&1; then
        termux-open-url "$url"
    elif command -v am >/dev/null 2>&1; then
        am start -a android.intent.action.VIEW \
                 -c android.intent.category.BROWSABLE \
                 -c android.intent.category.DEFAULT \
                 -d "$url" \
                 --activity-clear-top >/dev/null 2>&1
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1
    else
        log "未找到可用的浏览器启动方式，请手动访问 $url"
    fi
}

has_flag() {
    local f="$1"; shift
    for a in "$@"; do [ "$a" = "$f" ] && return 0; done
    return 1
}

# ---------- 命令分发 ----------

cmd="$1"
case "$cmd" in
    ""|start)
        [ -n "$cmd" ] && shift
        ensure_built || exit 1
        start_server || exit 1
        if ! has_flag --no-browser "$@" && [ "$("$BIN_PATH" config get server.open_browser 2>/dev/null)" != "false" ]; then
            open_browser
        fi
        log "就绪。m_s help 查看全部命令，m_s :q 停止服务。"
        ;;
    :q|:q!|:wq|quit|stop)
        stop_server
        ;;
    restart)
        shift
        stop_server
        ensure_built || exit 1
        start_server || exit 1
        has_flag --open "$@" && open_browser
        log "已重启。"
        ;;
    open)
        ensure_built || exit 1
        start_server || exit 1
        open_browser
        ;;
    logs|log)
        [ -f "$LOG_FILE" ] || { log "暂无服务日志：$LOG_FILE"; exit 1; }
        if has_flag -f "$@" || has_flag --follow "$@"; then
            tail -n 50 -f "$LOG_FILE"
        else
            tail -n 100 "$LOG_FILE"
        fi
        ;;
    rebuild)
        rm -f "$FRONTEND_DIR/dist/index.html" "$BIN_PATH"
        ensure_built || exit 1
        log "重新构建完成。"
        ;;
    help|-h|--help|version|--version|-v|config|status)
        # 不需要（或自行检测）服务运行状态的命令
        ensure_built || exit 1
        exec "$BIN_PATH" "$@"
        ;;
    *)
        ensure_built || exit 1
        start_server >/dev/null 2>&1 || { log "服务未能启动（m_s logs 查看原因）"; exit 3; }
        exec "$BIN_PATH" "$@"
        ;;
esac
